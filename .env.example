# ── Mattermost ────────────────────────────────
MATTERMOST_TOKEN=your_mattermost_verification_token_here
MATTERMOST_BOT_TOKEN=your_mattermost_bot_token_here
MATTERMOST_BASE_URL=https://your-mattermost-instance.com

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://srijan:srijan@localhost:5432/srijan

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Agent Platform (NeevCloud Agentic Studio) ─────────────
NEEV_API_KEY=your_neev_api_key_here
NEEV_ORG_ID=your_org_id_here
NEEV_PROJECT_ID=your_project_id_here
NEEV_BASE_URL=https://api.ai.neevcloud.com/agent

DEV_AGENT_TEMPLATE=claude-code
DEBUG_AGENT_TEMPLATE=claude-code

GITHUB_TOKEN=github_app_token_with_write_access
GITHUB_TOKEN_READONLY=github_app_token_read_only
K8S_CREDENTIALS=short_lived_readonly_cluster_token
SIGNDZ_API_KEY=platform_api_key_readonly
READONLY_DB_URL=postgresql://readonly_user:pass@host:5432/app_db

DEV_AGENT_EGRESS_HOSTS=github.com,api.anthropic.com
DEBUG_AGENT_EGRESS_HOSTS=api.anthropic.com

DEV_AGENT_COMMAND_TEMPLATE="claude-code --print {task}"
DEBUG_AGENT_COMMAND_TEMPLATE="claude-code --print {task}"

AGENT_TASK_TIME_LIMIT_SECONDS=900
AGENT_TASK_SOFT_TIME_LIMIT_SECONDS=870
AGENT_READY_POLL_INTERVAL_SECONDS=10