# ── Mattermost ────────────────────────────────
MATTERMOST_TOKEN=your_mattermost_verification_token_here
MATTERMOST_BOT_TOKEN=your_mattermost_bot_token_here
MATTERMOST_BASE_URL=https://your-mattermost-instance.com

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://srijan:srijan@localhost:5432/srijan

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Agent Platform (NeevCloud Agentic Studio) ─────────────
# NEEV_API_KEY must be a project API key with the "aiagent" resource type —
# PATs and inference-scoped keys are rejected by the sandbox data plane.
NEEV_API_KEY=your_neev_api_key_here
NEEV_ORG_ID=your_org_id_here
NEEV_PROJECT_ID=your_project_id_here
NEEV_BASE_URL=https://api.ai.neevcloud.com/agent

# Which catalogue template each command type provisions. Each template needs
# an adapter in src/agents/adapters/ (currently: claude-code, opencode).
DEV_AGENT_TEMPLATE=claude-code
DEBUG_AGENT_TEMPLATE=claude-code

# ── Inference (required when using the opencode template) ─
# OpenAI-compatible endpoint the opencode agent talks to. No code defaults —
# the opencode adapter fails the job with a clear error if these are unset.
INFERENCE_API_KEY=your_inference_api_key_here
INFERENCE_BASE_URL=https://inference.ai.neevcloud.com/v1
INFERENCE_MODEL=minimax-m3

GITHUB_TOKEN=github_app_token_with_write_access
GITHUB_TOKEN_READONLY=github_app_token_read_only
K8S_CREDENTIALS=short_lived_readonly_cluster_token
SIGNDZ_API_KEY=platform_api_key_readonly
READONLY_DB_URL=postgresql://readonly_user:pass@host:5432/app_db

# Empty -> the agent platform applies the template's default egress
# allow-list (model providers + toolchain hosts). Set to override.
DEV_AGENT_EGRESS_HOSTS=
DEBUG_AGENT_EGRESS_HOSTS=

# Empty -> the agent adapter's default command is used
# (claude-code: `claude-code --print {task}`, opencode: `opencode run {task}`).
DEV_AGENT_COMMAND_TEMPLATE=
DEBUG_AGENT_COMMAND_TEMPLATE=

AGENT_TASK_TIME_LIMIT_SECONDS=900
AGENT_TASK_SOFT_TIME_LIMIT_SECONDS=870
AGENT_READY_POLL_INTERVAL_SECONDS=10